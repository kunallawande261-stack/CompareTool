<mah:MetroWindow x:Class="FolderComparerUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:conv="clr-namespace:FolderComparerUI.Converters"
    xmlns:vm="clr-namespace:FolderComparerUI.ViewModels"
    mc:Ignorable="d"
    Title="Folder Comparer"
    Height="720" Width="1100"
    FontFamily="Segoe UI"
    WindowStartupLocation="CenterScreen"
    GlowBrush="DodgerBlue"
    BorderThickness="0"
    Topmost="{Binding Topmost}"
    Loaded="MetroWindow_Loaded"
    Closing="MetroWindow_Closing"
    StateChanged="MetroWindow_StateChanged"
    SizeChanged="MetroWindow_SizeChanged">

    <mah:MetroWindow.InputBindings>
        <KeyBinding Key="F5"     Command="{Binding AnalyzeCommand}"/>
        <KeyBinding Key="R"      Command="{Binding ReloadCommand}"      Modifiers="Ctrl"/>
        <KeyBinding Key="E"      Command="{Binding ExportExcelCommand}" Modifiers="Ctrl"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </mah:MetroWindow.InputBindings>

    <mah:MetroWindow.TitleTemplate>
        <DataTemplate>
            <StackPanel Orientation="Horizontal">
                <Border Background="White" CornerRadius="2" Margin="1">
                    <Image Source="/Assets/icon.ico" Width="24" Height="24"/>
                </Border>
                <TextBlock Text="{Binding}" FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="8,0,0,0"/>
            </StackPanel>
        </DataTemplate>
    </mah:MetroWindow.TitleTemplate>

    <mah:MetroWindow.Resources>
        <conv:CategoryToSymbolConverter  x:Key="CategoryToSymbol"/>
        <conv:StringToVisibilityConverter x:Key="StrToVis"/>
        <conv:StringToBrushConverter     x:Key="StrToBrush"/>
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#5E6B78"/>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Height"      Value="30"/>
            <Setter Property="Padding"     Value="10,0"/>
            <Setter Property="Background"  Value="#1E5C9B"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="BorderBrush" Value="#174A82"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Cursor"      Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
            <Setter Property="Height"      Value="30"/>
            <Setter Property="Padding"     Value="10,0"/>
            <Setter Property="Background"  Value="#EFF5FB"/>
            <Setter Property="Foreground"  Value="#1A3A5C"/>
            <Setter Property="BorderBrush" Value="#C4D8EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Cursor"      Value="Hand"/>
        </Style>

        <Style x:Key="PathInputStyle" TargetType="TextBox">
            <Setter Property="Height"      Value="30"/>
            <Setter Property="Padding"     Value="8,0"/>
            <Setter Property="BorderBrush" Value="#C9D8E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ExplorerIconButtonStyle" TargetType="Button">
            <Setter Property="Width"       Value="28"/>
            <Setter Property="Height"      Value="28"/>
            <Setter Property="Margin"      Value="5,0,0,0"/>
            <Setter Property="Padding"     Value="0"/>
            <Setter Property="Background"  Value="#EBF2FA"/>
            <Setter Property="Foreground"  Value="#1A3A5C"/>
            <Setter Property="BorderBrush" Value="#BACED8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
        </Style>

        <Style x:Key="TopToolButtonStyle" TargetType="Button">
            <Setter Property="Height"    Value="28"/>
            <Setter Property="MinWidth"  Value="72"/>
            <Setter Property="Margin"    Value="0,0,4,0"/>
            <Setter Property="Padding"   Value="10,0"/>
            <Setter Property="Background"  Value="#EAF2FB"/>
            <Setter Property="Foreground"  Value="#1E3D5C"/>
            <Setter Property="BorderBrush" Value="#BFD2E7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"  Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor"    Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FlyoutToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height"    Value="28"/>
            <Setter Property="MinWidth"  Value="78"/>
            <Setter Property="Margin"    Value="0,0,5,0"/>
            <Setter Property="Padding"   Value="10,0"/>
            <Setter Property="Background"  Value="#F2F7FD"/>
            <Setter Property="Foreground"  Value="#1E3D5C"/>
            <Setter Property="BorderBrush" Value="#C7D8EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"  Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor"    Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CatCheckStyle" TargetType="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin"  Value="0,0,0,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- ── Shared flyout design system ─────────────────────────────── -->

        <Style x:Key="FlyoutBorderStyle" TargetType="Border">
            <Setter Property="Background"       Value="White"/>
            <Setter Property="BorderBrush"      Value="#C2D8EE"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="CornerRadius"     Value="10"/>
            <Setter Property="Padding"          Value="18,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.13" Color="#1A3A5C"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlyoutHeaderPanelStyle" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="FlyoutIconBorderStyle" TargetType="Border">
            <Setter Property="Width"        Value="32"/>
            <Setter Property="Height"       Value="32"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin"       Value="0,0,10,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
        </Style>

        <Style x:Key="FlyoutIconTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize"            Value="15"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
        </Style>

        <Style x:Key="FlyoutTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="14"/>
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="Foreground"        Value="#1A3A5C"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FlyoutSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"        Value="9"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Foreground"      Value="#8AAAC4"/>
            <Setter Property="Margin"          Value="0,0,0,5"/>
          
        </Style>

        <Style x:Key="FlyoutCardStyle" TargetType="Border">
            <Setter Property="Background"      Value="#F4F8FD"/>
            <Setter Property="BorderBrush"     Value="#DCE9F5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="14,12"/>
            <Setter Property="Margin"          Value="0,0,0,12"/>
        </Style>

        <Style x:Key="FlyoutCheckStyle" TargetType="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize"  Value="11"/>
            <Setter Property="Cursor"    Value="Hand"/>
        </Style>

        <Style x:Key="FlyoutCheckTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A3A5C"/>
        </Style>

        <Style x:Key="FlyoutCheckDescStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="Foreground" Value="#7090AE"/>
            <Setter Property="Margin"     Value="0,2,0,0"/>
        </Style>

    </mah:MetroWindow.Resources>

    <Border CornerRadius="10" BorderThickness="2" Margin="8" SnapsToDevicePixels="True">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#4A97DA" Offset="0"/>
                <GradientStop Color="#2E73B5" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <DockPanel>

            <!-- ═══════════════════════════════════════════════════════
                 ROW 1  —  Flyout toggle buttons
                 ═══════════════════════════════════════════════════════ -->
            <!-- ═══════════════════════════════════════════════════════
                 ROW 1  —  Flyout toggle buttons
                 ═══════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top"
                    Background="#D0E4F4" BorderBrush="#AECADF" BorderThickness="0,0,0,1"
                    Padding="8,6">
                <Grid>
                    <!-- Toggle buttons -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="btnOptionsFlyout"     Content="⚙ Options"      Style="{StaticResource FlyoutToggleStyle}"/>
                        <ToggleButton x:Name="btnCompareModeFlyout" Content="⚖ Compare Mode" Style="{StaticResource FlyoutToggleStyle}"/>
                        <ToggleButton x:Name="btnCopyFlyout"        Content="⧉ Copy"         Style="{StaticResource FlyoutToggleStyle}"/>
                        <ToggleButton x:Name="btnDeleteFlyout"      Content="⊟ Delete"       Style="{StaticResource FlyoutToggleStyle}"/>
                        <ToggleButton x:Name="btnExcelFlyout"       Content="▦ Excel"        Style="{StaticResource FlyoutToggleStyle}"/>
                    </StackPanel>

                    <!-- ══════════════ OPTIONS ══════════════ -->
                    <Popup Placement="Bottom"
                           PlacementTarget="{Binding ElementName=btnOptionsFlyout}"
                           IsOpen="{Binding IsChecked, ElementName=btnOptionsFlyout, Mode=TwoWay}"
                           StaysOpen="False" AllowsTransparency="True">
                        <Border Style="{StaticResource FlyoutBorderStyle}" MinWidth="440">
                            <StackPanel>
                                <!-- Header -->
                                <DockPanel Style="{StaticResource FlyoutHeaderPanelStyle}">
                                    <Border DockPanel.Dock="Left" Style="{StaticResource FlyoutIconBorderStyle}" Background="#E8F0FB">
                                        <TextBlock Text="⚙" Style="{StaticResource FlyoutIconTextStyle}" Foreground="#1E5C9B"/>
                                    </Border>
                                    <TextBlock Text="Options" Style="{StaticResource FlyoutTitleStyle}"/>
                                </DockPanel>

                                <!-- General section -->
                                <TextBlock Text="GENERAL" Style="{StaticResource FlyoutSectionLabelStyle}"/>
                                <Border Style="{StaticResource FlyoutCardStyle}">
                                    <StackPanel>
                                        <CheckBox IsChecked="{Binding EnableLogging}" Cursor="Hand" Style="{StaticResource FlyoutCheckStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Enable logging" Style="{StaticResource FlyoutCheckTitleStyle}"/>
                                                <TextBlock Text="Write comparison events to a log file" Style="{StaticResource FlyoutCheckDescStyle}"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <!-- Log path row — only when logging on -->
                                        <Grid Margin="24,8,0,0"
                                              Visibility="{Binding LogPathVisibility, Converter={StaticResource StrToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="44"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Log path:" VerticalAlignment="Center" FontSize="11" Foreground="#5A7A9A"/>
                                            <TextBox Grid.Column="1" x:Name="txtLogPath" Margin="0,0,6,0"
                                                     Style="{StaticResource PathInputStyle}"
                                                     Text="{Binding LogPath, UpdateSourceTrigger=PropertyChanged}"
                                                     AllowDrop="True" PreviewDragOver="TextBox_PreviewDragOver" Drop="TextBox_Drop"/>
                                            <Button Grid.Column="2" Content="..." Command="{Binding BrowseLogCommand}"
                                                    Style="{StaticResource SecondaryActionButtonStyle}"/>
                                        </Grid>
                                        <CheckBox IsChecked="{Binding Topmost}" Cursor="Hand" Margin="0,10,0,0" Style="{StaticResource FlyoutCheckStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Keep window topmost" Style="{StaticResource FlyoutCheckTitleStyle}"/>
                                                <TextBlock Text="Always on top when not maximised" Style="{StaticResource FlyoutCheckDescStyle}"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </Border>

                                <!-- Beyond Compare section -->
                                <TextBlock Text="BEYOND COMPARE" Style="{StaticResource FlyoutSectionLabelStyle}"/>
                                <Border Style="{StaticResource FlyoutCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Path to BCompare.exe" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#2C4A6A" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="52"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" x:Name="txtBcPath" Margin="0,0,6,0"
                                                     Style="{StaticResource PathInputStyle}"
                                                     Text="{Binding BcPath, UpdateSourceTrigger=PropertyChanged}"
                                                     AllowDrop="True" PreviewDragOver="TextBox_PreviewDragOver" Drop="TextBox_Drop"
                                                     ToolTip="Path to BCompare.exe — leave blank to auto-detect"/>
                                            <Button Grid.Column="1" Content="..." Margin="0,0,4,0" Command="{Binding BrowseBcPathCommand}" Style="{StaticResource SecondaryActionButtonStyle}"/>
                                            <Button Grid.Column="2" Content="Save"  Margin="0,0,4,0" Command="{Binding SaveBcPathCommand}"   Style="{StaticResource SecondaryActionButtonStyle}"/>
                                            <Button Grid.Column="3" Content="Clear"                   Command="{Binding ClearBcPathCommand}"  Style="{StaticResource SecondaryActionButtonStyle}"/>
                                        </Grid>
                                        <TextBlock Margin="0,6,0,0" FontSize="10"
                                                   Text="{Binding BcStatusText}"
                                                   Foreground="{Binding BcStatusForeground, Converter={StaticResource StrToBrush}}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- ══════════════ COMPARE MODE ══════════════ -->
                    <Popup Placement="Bottom"
                           PlacementTarget="{Binding ElementName=btnCompareModeFlyout}"
                           IsOpen="{Binding IsChecked, ElementName=btnCompareModeFlyout, Mode=TwoWay}"
                           StaysOpen="False" AllowsTransparency="True">
                        <Border Style="{StaticResource FlyoutBorderStyle}" MinWidth="320">
                            <StackPanel>
                                <!-- Header -->
                                <DockPanel Style="{StaticResource FlyoutHeaderPanelStyle}">
                                    <Border DockPanel.Dock="Left" Style="{StaticResource FlyoutIconBorderStyle}" Background="#E8F0FB">
                                        <TextBlock Text="⚖" Style="{StaticResource FlyoutIconTextStyle}" Foreground="#1E5C9B"/>
                                    </Border>
                                    <TextBlock Text="Compare Mode" Style="{StaticResource FlyoutTitleStyle}"/>
                                </DockPanel>

                                <!-- Options section -->
                                <TextBlock Text="OPTIONS" Style="{StaticResource FlyoutSectionLabelStyle}"/>
                                <Border Style="{StaticResource FlyoutCardStyle}">
                                    <StackPanel>
                                        <CheckBox IsChecked="{Binding SmartXml}" Cursor="Hand" Style="{StaticResource FlyoutCheckStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Smart XML compare" Style="{StaticResource FlyoutCheckTitleStyle}"/>
                                                <TextBlock Text="Normalise .xml / .aml / .svg before diff" Style="{StaticResource FlyoutCheckDescStyle}"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding ForceReread}" Cursor="Hand" Margin="0,10,0,0" Style="{StaticResource FlyoutCheckStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Force re-read" Style="{StaticResource FlyoutCheckTitleStyle}"/>
                                                <TextBlock Text="Bypass hash cache — re-read all files from disk" Style="{StaticResource FlyoutCheckDescStyle}"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </Border>

                                <!-- Hash strategy section -->
                                <TextBlock Text="HASH STRATEGY" Style="{StaticResource FlyoutSectionLabelStyle}"/>
                                <Border Style="{StaticResource FlyoutCardStyle}">
                                    <StackPanel>
                                        <RadioButton x:Name="rdNormal" GroupName="CompareMode" Cursor="Hand"
                                                    
                                                     Checked="CompareMode_Normal_Checked">
                                            <StackPanel>
                                                <TextBlock Text="Normal" Style="{StaticResource FlyoutCheckTitleStyle}"/>
                                                <TextBlock Text="Size mismatch → skip hash  (faster)" Style="{StaticResource FlyoutCheckDescStyle}"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="rdHashOnly" GroupName="CompareMode" Cursor="Hand"
                                                     Margin="0,10,0,0" 
                                                     Checked="CompareMode_HashOnly_Checked">
                                            <StackPanel>
                                                <TextBlock Text="Hash only" Style="{StaticResource FlyoutCheckTitleStyle}"/>
                                                <TextBlock Text="Always hash regardless of size  (thorough)" Style="{StaticResource FlyoutCheckDescStyle}"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- ══════════════ COPY ══════════════ -->
                    <Popup Placement="Bottom"
                           PlacementTarget="{Binding ElementName=btnCopyFlyout}"
                           IsOpen="{Binding IsChecked, ElementName=btnCopyFlyout, Mode=TwoWay}"
                           StaysOpen="False" AllowsTransparency="True"
                           Opened="CopyFlyout_Opened">
                        <Border Style="{StaticResource FlyoutBorderStyle}" MinWidth="420">
                            <StackPanel>
                                <!-- Header -->
                                <DockPanel Style="{StaticResource FlyoutHeaderPanelStyle}">
                                    <Border DockPanel.Dock="Left" Style="{StaticResource FlyoutIconBorderStyle}" Background="#E8F5E9">
                                        <TextBlock Text="⧉" Style="{StaticResource FlyoutIconTextStyle}" Foreground="#2E7D32"/>
                                    </Border>
                                    <TextBlock Text="Copy Files" Style="{StaticResource FlyoutTitleStyle}"/>
                                </DockPanel>

                                <!-- Settings section -->
                                <TextBlock Text="SETTINGS" Style="{StaticResource FlyoutSectionLabelStyle}"/>
                                <Border Style="{StaticResource FlyoutCardStyle}">
                                    <StackPanel>
                                        <!-- Target set row -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="86"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Target set:" VerticalAlignment="Center"
                                                       FontSize="11" FontWeight="SemiBold" Foreground="#2C4A6A"/>
                                            <ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding TargetTag}">
                                                <ComboBoxItem Tag="2">Left-Orphans</ComboBoxItem>
                                                <ComboBoxItem Tag="3">Right-Orphans</ComboBoxItem>
                                                <ComboBoxItem Tag="4L">Different — Left folder only</ComboBoxItem>
                                                <ComboBoxItem Tag="4R">Different — Right folder only</ComboBoxItem>
                                                <ComboBoxItem Tag="5">All sets</ComboBoxItem>
                                                <ComboBoxItem Tag="1">Same</ComboBoxItem>
                                                <ComboBoxItem Tag="CL">Copy entire Left folder</ComboBoxItem>
                                                <ComboBoxItem Tag="CR">Copy entire Right folder</ComboBoxItem>
                                            </ComboBox>
                                        </Grid>
                                        <!-- Destination row -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="86"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="44"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Destination:" VerticalAlignment="Center"
                                                       FontSize="11" FontWeight="SemiBold" Foreground="#2C4A6A"/>
                                            <TextBox Grid.Column="1" x:Name="txtExportPath" Margin="0,0,6,0"
                                                     Style="{StaticResource PathInputStyle}"
                                                     Text="{Binding ExportPath, UpdateSourceTrigger=PropertyChanged}"
                                                     AllowDrop="True" PreviewDragOver="TextBox_PreviewDragOver" Drop="TextBox_Drop"/>
                                            <Button Grid.Column="2" Content="..." Command="{Binding BrowseExportCommand}"
                                                    Style="{StaticResource SecondaryActionButtonStyle}"/>
                                        </Grid>
                                        <!-- Subfolder toggle -->
                                        <CheckBox IsChecked="{Binding CategorySubfolders}" Cursor="Hand"
                                                  Style="{StaticResource FlyoutCheckStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Create category subfolders" Style="{StaticResource FlyoutCheckTitleStyle}"/>
                                                <TextBlock Text="Organise output into Same / Diff / LeftOnly sub-folders" Style="{StaticResource FlyoutCheckDescStyle}"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </Border>

                                <!-- Action row -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="▶  Start" Width="100" Margin="0,0,8,0"
                                            Command="{Binding StartCommand}"
                                            Style="{StaticResource PrimaryActionButtonStyle}"/>
                                    <Button Content="✕  Cancel" Width="88"
                                            Command="{Binding CancelCommand}"
                                            Style="{StaticResource SecondaryActionButtonStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- ══════════════ DELETE ══════════════ -->
                    <Popup Placement="Bottom"
                           PlacementTarget="{Binding ElementName=btnDeleteFlyout}"
                           IsOpen="{Binding IsChecked, ElementName=btnDeleteFlyout, Mode=TwoWay}"
                           StaysOpen="False" AllowsTransparency="True"
                           Opened="DeleteFlyout_Opened">
                        <Border Style="{StaticResource FlyoutBorderStyle}" MinWidth="420">
                            <StackPanel>
                                <!-- Header — red tint to signal destructive action -->
                                <DockPanel Style="{StaticResource FlyoutHeaderPanelStyle}">
                                    <Border DockPanel.Dock="Left" Style="{StaticResource FlyoutIconBorderStyle}" Background="#FDECEA">
                                        <TextBlock Text="⊟" Style="{StaticResource FlyoutIconTextStyle}" Foreground="#C0392B"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Delete Files" Style="{StaticResource FlyoutTitleStyle}"/>
                                        <TextBlock Text="Files are sent to the Recycle Bin unless you choose permanent."
                                                   FontSize="10" Foreground="#A04040" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Settings section -->
                                <TextBlock Text="SETTINGS" Style="{StaticResource FlyoutSectionLabelStyle}"/>
                                <Border Style="{StaticResource FlyoutCardStyle}">
                                    <StackPanel>
                                        <!-- Target set row -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="86"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Target set:" VerticalAlignment="Center"
                                                       FontSize="11" FontWeight="SemiBold" Foreground="#2C4A6A"/>
                                            <ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding TargetTag}">
                                                <ComboBoxItem Tag="2">Left-Orphans</ComboBoxItem>
                                                <ComboBoxItem Tag="3">Right-Orphans</ComboBoxItem>
                                                <ComboBoxItem Tag="4">Different (both sides)</ComboBoxItem>
                                                <ComboBoxItem Tag="4L">Different — Left folder only</ComboBoxItem>
                                                <ComboBoxItem Tag="4R">Different — Right folder only</ComboBoxItem>
                                                <ComboBoxItem Tag="5">All sets</ComboBoxItem>
                                                <ComboBoxItem Tag="1">Same (both sides)</ComboBoxItem>
                                                <ComboBoxItem Tag="1L">Same — Left folder only</ComboBoxItem>
                                                <ComboBoxItem Tag="1R">Same — Right folder only</ComboBoxItem>
                                            </ComboBox>
                                        </Grid>
                                        <!-- Keep root toggle -->
                                        <CheckBox IsChecked="{Binding KeepRoot}" Cursor="Hand"
                                                  Visibility="{Binding KeepRootVisibility, Converter={StaticResource StrToVis}}"
                                                  Style="{StaticResource FlyoutCheckStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Keep root folder if empty" Style="{StaticResource FlyoutCheckTitleStyle}"/>
                                                <TextBlock Text="Don't delete the root folder even when all its files are removed" Style="{StaticResource FlyoutCheckDescStyle}"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </Border>

                                <!-- Action row -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="▶  Start" Width="100" Margin="0,0,8,0"
                                            Command="{Binding StartCommand}"
                                            Style="{StaticResource PrimaryActionButtonStyle}"/>
                                    <Button Content="✕  Cancel" Width="88"
                                            Command="{Binding CancelCommand}"
                                            Style="{StaticResource SecondaryActionButtonStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- ══════════════ EXCEL ══════════════ -->
                    <Popup Placement="Bottom"
                           PlacementTarget="{Binding ElementName=btnExcelFlyout}"
                           IsOpen="{Binding IsChecked, ElementName=btnExcelFlyout, Mode=TwoWay}"
                           StaysOpen="False" AllowsTransparency="True">
                        <Border Style="{StaticResource FlyoutBorderStyle}" MinWidth="420">
                            <StackPanel>
                                <!-- Header -->
                                <DockPanel Style="{StaticResource FlyoutHeaderPanelStyle}">
                                    <Border DockPanel.Dock="Left" Style="{StaticResource FlyoutIconBorderStyle}" Background="#FFF8E1">
                                        <TextBlock Text="▦" Style="{StaticResource FlyoutIconTextStyle}" Foreground="#E65100"/>
                                    </Border>
                                    <TextBlock Text="Export to Excel" Style="{StaticResource FlyoutTitleStyle}"/>
                                </DockPanel>

                                <!-- Settings section -->
                                <TextBlock Text="SETTINGS" Style="{StaticResource FlyoutSectionLabelStyle}"/>
                                <Border Style="{StaticResource FlyoutCardStyle}">
                                    <StackPanel>
                                        <!-- Save-to path -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="86"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="44"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Save to:" VerticalAlignment="Center"
                                                       FontSize="11" FontWeight="SemiBold" Foreground="#2C4A6A"/>
                                            <TextBox Grid.Column="1" x:Name="txtExcelPath" Margin="0,0,6,0"
                                                     Style="{StaticResource PathInputStyle}"
                                                     Text="{Binding ExcelPath, UpdateSourceTrigger=PropertyChanged}"
                                                     AllowDrop="True" PreviewDragOver="TextBox_PreviewDragOver" Drop="TextBox_Drop"/>
                                            <Button Grid.Column="2" Content="..." Command="{Binding BrowseExcelCommand}"
                                                    Style="{StaticResource SecondaryActionButtonStyle}"/>
                                        </Grid>
                                        <!-- Sheet name -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="86"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Sheet name:" VerticalAlignment="Center"
                                                       FontSize="11" FontWeight="SemiBold" Foreground="#2C4A6A"/>
                                            <TextBox Grid.Column="1" Style="{StaticResource PathInputStyle}"
                                                     MaxLength="31"
                                                     Text="{Binding SheetName, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>
                                        <!-- Category -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="86"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Category:" VerticalAlignment="Center"
                                                       FontSize="11" FontWeight="SemiBold" Foreground="#2C4A6A"/>
                                            <ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding ExcelCategoryTag}">
                                                <ComboBoxItem Tag="1">Same</ComboBoxItem>
                                                <ComboBoxItem Tag="2">Left-Orphans</ComboBoxItem>
                                                <ComboBoxItem Tag="3">Right-Orphans</ComboBoxItem>
                                                <ComboBoxItem Tag="4">Different</ComboBoxItem>
                                                <ComboBoxItem Tag="5">All</ComboBoxItem>
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Action row -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="▦  Export" Width="100"
                                            Command="{Binding ExportExcelCommand}"
                                            Style="{StaticResource PrimaryActionButtonStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>

                </Grid>
            </Border>


            <!-- ═══════════════════════════════════════════════════════
                 ROW 2  —  Action buttons (left)  +  Search / Filter (right)
                 ═══════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top"
                    Background="#EAF1F9" BorderBrush="#C5D5E5" BorderThickness="0,0,0,1"
                    Padding="8,5">
                <DockPanel LastChildFill="False" VerticalAlignment="Center">

                    <!-- ── Left: action buttons ── -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Button Content="▶ Start"  Command="{Binding AnalyzeCommand}"     Style="{StaticResource TopToolButtonStyle}"/>
                        <Button Content="↺ Reload" Command="{Binding ReloadCommand}"      Style="{StaticResource TopToolButtonStyle}"/>
                        <Button Content="↗ Excel"  Command="{Binding ExportExcelCommand}" Style="{StaticResource TopToolButtonStyle}"/>
                        <!-- FIX: was bound to AnalyzeCommand — corrected to CancelCommand -->
                        <Button Content="✕ Cancel" Command="{Binding CancelCommand}"      Style="{StaticResource TopToolButtonStyle}"/>
                    </StackPanel>

                    <!-- ── Divider ── -->
                    <Border DockPanel.Dock="Left" Width="1" Background="#BDD0E2" Margin="6,3" VerticalAlignment="Stretch"/>

                    <!-- ── Right: exclude · view · search · clear ── -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                                VerticalAlignment="Center" Margin="0,0,2,0">

                        <!-- Exclude label + box -->
                        <TextBlock Text="Exclude:" VerticalAlignment="Center"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#2C4966" Margin="0,0,5,0"/>
                        <TextBox Width="140" Height="26" Padding="6,0"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding ExcludePatterns, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Exclude patterns: .ext  folder  *.tmp"
                                 BorderBrush="#C9D8E8" BorderThickness="1"/>

                        <!-- Thin divider -->
                        <Border Width="1" Background="#C5D5E5" Margin="8,2" VerticalAlignment="Stretch"/>

                        <!-- View filter toggle -->
                        <TextBlock Text="View:" VerticalAlignment="Center"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#2C4966" Margin="0,0,5,0"/>
                        <ToggleButton x:Name="btnViewDrop"
                                      Width="30" Height="26" Padding="0"
                                      Content="▾" Cursor="Hand"
                                      Background="#EAF2FB" BorderBrush="#BFD2E7" BorderThickness="1"
                                      FontSize="12" VerticalContentAlignment="Center"/>
                        <Popup Placement="Bottom"
                               PlacementTarget="{Binding ElementName=btnViewDrop}"
                               IsOpen="{Binding IsChecked, ElementName=btnViewDrop, Mode=TwoWay}"
                               StaysOpen="False" AllowsTransparency="True">
                            <Border Background="White" BorderBrush="#C2D8EE" BorderThickness="1"
                                    CornerRadius="7" Padding="12,10" MinWidth="170">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.13" Color="#1A3A5C"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="Show categories" FontWeight="SemiBold"
                                               FontSize="11" Foreground="#1A3A5C" Margin="0,0,0,8"/>
                                    <CheckBox Content="Same"       IsChecked="{Binding ShowSame}"        Style="{StaticResource CatCheckStyle}"/>
                                    <CheckBox Content="Different"  IsChecked="{Binding ShowDifferent}"   Style="{StaticResource CatCheckStyle}"/>
                                    <CheckBox Content="Left only"  IsChecked="{Binding ShowLeftOrphan}"  Style="{StaticResource CatCheckStyle}"/>
                                    <CheckBox Content="Right only" IsChecked="{Binding ShowRightOrphan}" Style="{StaticResource CatCheckStyle}"/>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- Thin divider -->
                        <Border Width="1" Background="#C5D5E5" Margin="8,2" VerticalAlignment="Stretch"/>

                        <!-- Search icon + filter box -->
                        <Border Background="#EAF2FB" BorderBrush="#BFD2E7" BorderThickness="1"
                                CornerRadius="4" Height="26" Padding="6,0">
                            <DockPanel>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" Opacity="0.6" Foreground="#1A3A5C"
                                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox Width="150" VerticalContentAlignment="Center"
                                         Background="Transparent" BorderThickness="0"
                                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Filter by path or category"/>
                            </DockPanel>
                        </Border>

                        <!-- Clear filter button (only when filter active) -->
                        <Button Content="✕" Width="26" Height="26" Margin="4,0,0,0"
                                Padding="0"
                                Command="{Binding ClearFilterCommand}"
                                ToolTip="Clear all filters"
                                Background="#F5E0E0" Foreground="#8B1A1A"
                                BorderBrush="#D9AAAA" BorderThickness="1"
                                FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                                Visibility="{Binding FilterHasText, Converter={StaticResource StrToVis}}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════
                 BOTTOM  —  Status bar
                 ═══════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Bottom"
                    Background="#F6FAFE" BorderBrush="#D3E3F2" BorderThickness="0,1,0,0"
                    Padding="10,5">
                <DockPanel>
                    <ProgressBar DockPanel.Dock="Left" Width="220" Height="14" Margin="0,0,10,0"
                                 VerticalAlignment="Center"
                                 Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue}"/>
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource SubtleTextBrush}" Margin="12,0,0,0"
                               Text="{Binding ResultCountText}"/>
                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#2F4D68"
                               Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════
                 MAIN CONTENT
                 ═══════════════════════════════════════════════════════ -->
            <Grid Margin="10,8,10,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="120"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ── ROW 3: Folder path selectors ── -->
                    <Border Grid.Row="0"
                            Background="#F2F8FF" BorderBrush="#C8D7E8" BorderThickness="1"
                            CornerRadius="6" Padding="8,6" Margin="0,0,0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="200"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*" MinWidth="200"/>
                            </Grid.ColumnDefinitions>

                            <DockPanel Grid.Column="0" LastChildFill="True">
                                <TextBlock DockPanel.Dock="Left" Text="Left:" VerticalAlignment="Center"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#2C4966" Margin="0,0,6,0"/>
                                <Button DockPanel.Dock="Right" Content="..." Command="{Binding BrowseLeftCommand}"
                                        Style="{StaticResource ExplorerIconButtonStyle}"/>
                                <TextBox x:Name="txtLeft" Style="{StaticResource PathInputStyle}"
                                         Text="{Binding LeftPath, UpdateSourceTrigger=PropertyChanged}"
                                         AllowDrop="True" PreviewDragOver="TextBox_PreviewDragOver" Drop="TextBox_Drop"
                                         ToolTip="{Binding LeftPath}"/>
                            </DockPanel>

                            <TextBlock Grid.Column="1" Text="⟷" FontSize="16" Foreground="#6A95BB"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <DockPanel Grid.Column="2" LastChildFill="True">
                                <TextBlock DockPanel.Dock="Left" Text="Right:" VerticalAlignment="Center"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#2C4966" Margin="0,0,6,0"/>
                                <Button DockPanel.Dock="Right" Content="..." Command="{Binding BrowseRightCommand}"
                                        Style="{StaticResource ExplorerIconButtonStyle}"/>
                                <TextBox x:Name="txtRight" Style="{StaticResource PathInputStyle}"
                                         Text="{Binding RightPath, UpdateSourceTrigger=PropertyChanged}"
                                         AllowDrop="True" PreviewDragOver="TextBox_PreviewDragOver" Drop="TextBox_Drop"
                                         ToolTip="{Binding RightPath}"/>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- ── Column header bar ── -->
                    <Grid Grid.Row="2">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#2A6EAC" Offset="0"/>
                                <GradientStop Color="#225D93" Offset="1"/>
                            </LinearGradientBrush>
                        </Grid.Background>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                            <ColumnDefinition Width="17"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnSortLeft" Grid.Column="0"
                                Content="{Binding SortLeftHeader}" Command="{Binding SortLeftCommand}"
                                Height="32" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                Background="Transparent" BorderThickness="0,0,1,0" BorderBrush="#4E88BD"
                                HorizontalContentAlignment="Center" Padding="10,0"/>

                        <Button x:Name="btnSortCategory" Grid.Column="1"
                                Content="{Binding SortCategoryHeader}" Command="{Binding SortCategoryCommand}"
                                Height="32" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                Background="Transparent" BorderThickness="1,0,1,0" BorderBrush="#4E88BD"
                                HorizontalContentAlignment="Center"/>

                        <!-- Right header + inline Clear Sort button -->
                        <DockPanel Grid.Column="2" LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Content="✕" ToolTip="Clear sort"
                                    Command="{Binding ClearSortCommand}"
                                    Visibility="{Binding SortIsActive, Converter={StaticResource StrToVis}}"
                                    Width="26" Height="26" Padding="0"
                                    Margin="0,3,4,3"
                                    Background="#1A5490" Foreground="#AACFEE"
                                    BorderBrush="#4E88BD" BorderThickness="1"
                                    FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                            <Button x:Name="btnSortRight"
                                    Content="{Binding SortRightHeader}" Command="{Binding SortRightCommand}"
                                    Height="32" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                    Background="Transparent" BorderThickness="1,0,0,0" BorderBrush="#4E88BD"
                                    HorizontalContentAlignment="Center" Padding="10,0"/>
                        </DockPanel>
                    </Grid>

                    <!-- ── Results ListView ── -->
                    <ListView Grid.Row="3" x:Name="lvResults"
                              ItemsSource="{Binding ResultItems}"
                              SelectedItem="{Binding SelectedRow}"
                              BorderThickness="1" BorderBrush="#CADBEC"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ContextMenuOpening="LvResults_ContextMenuOpening"
                              SelectionChanged="lvResults_SelectionChanged"
                              Background="White">

                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment"   Value="Center"/>
                                <Setter Property="Padding"         Value="0"/>
                                <Setter Property="Margin"          Value="0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush"     Value="#E6EEF7"/>
                                <Setter Property="MinHeight"       Value="32"/>
                                <Setter Property="Background"      Value="White"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter
                                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#ECF5FF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush"     Value="#1E5C9B"/>
                                                    <Setter TargetName="Bd" Property="BorderThickness" Value="0,1,0,1"/>
                                                    <Setter TargetName="Bd" Property="Background"      Value="#DCEEFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <MenuItem Header="Open Left in Explorer"        Name="ctxOpenLeftExplorer"/>
                                            <MenuItem Header="Open Right in Explorer"       Name="ctxOpenRightExplorer"/>
                                            <Separator/>
                                            <MenuItem Header="Open Left in Beyond Compare"  Name="ctxBcLeft"/>
                                            <MenuItem Header="Open Right in Beyond Compare" Name="ctxBcRight"/>
                                            <MenuItem Header="Compare in Beyond Compare"    Name="ctxBcCompare"/>
                                            <Separator Name="ctxActionSep"/>
                                            <MenuItem Header="Copy to Right"   Name="ctxCopyToRight"/>
                                            <MenuItem Header="Copy to Left"    Name="ctxCopyToLeft"/>
                                            <Separator Name="ctxDeleteSep"/>
                                            <MenuItem Header="Delete Left"     Name="ctxDeleteLeft"/>
                                            <MenuItem Header="Delete Right"    Name="ctxDeleteRight"/>
                                            <MenuItem Header="Delete Both"     Name="ctxDeleteBoth"/>
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Category}" Value="Same">
                                        <Setter Property="Background" Value="#F0FAF1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" Value="Different">
                                        <Setter Property="Background" Value="#FFF8F0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" Value="Left-Orphan">
                                        <Setter Property="Background" Value="#F0F6FF"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Category}" Value="Right-Orphan">
                                        <Setter Property="Background" Value="#F6F2FF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="200"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*" MinWidth="200"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" BorderBrush="#E0EAF5" BorderThickness="0,0,1,0" Padding="10,6">
                                        <TextBlock Text="{Binding LeftFull}"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                   VerticalAlignment="Center" FontSize="12" Foreground="#2C3E50"
                                                   ToolTip="{Binding LeftFull}"/>
                                    </Border>

                                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            CornerRadius="10" Padding="8,3" Margin="4,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"      Value="#E0E0E0"/>
                                                <Setter Property="BorderBrush"     Value="#BDBDBD"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Category}" Value="Same">
                                                        <Setter Property="Background"  Value="#E8F5E9"/>
                                                        <Setter Property="BorderBrush" Value="#A5D6A7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="Different">
                                                        <Setter Property="Background"  Value="#FFF3E0"/>
                                                        <Setter Property="BorderBrush" Value="#FFCC80"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="Left-Orphan">
                                                        <Setter Property="Background"  Value="#E3F2FD"/>
                                                        <Setter Property="BorderBrush" Value="#90CAF9"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="Right-Orphan">
                                                        <Setter Property="Background"  Value="#EDE7F6"/>
                                                        <Setter Property="BorderBrush" Value="#CE93D8"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   FontSize="11" FontWeight="SemiBold" ToolTip="{Binding Category}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text"       Value="?"/>
                                                    <Setter Property="Foreground" Value="#616161"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Category}" Value="Same">
                                                            <Setter Property="Text"       Value="= Same"/>
                                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Category}" Value="Different">
                                                            <Setter Property="Text"       Value="!= Diff"/>
                                                            <Setter Property="Foreground" Value="#E65100"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Category}" Value="Left-Orphan">
                                                            <Setter Property="Text"       Value="Left only"/>
                                                            <Setter Property="Foreground" Value="#1565C0"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Category}" Value="Right-Orphan">
                                                            <Setter Property="Text"       Value="Right only"/>
                                                            <Setter Property="Foreground" Value="#6A1B9A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <Border Grid.Column="2" BorderBrush="#E0EAF5" BorderThickness="1,0,0,0" Padding="10,6">
                                        <TextBlock Text="{Binding RightFull}"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                   VerticalAlignment="Center" FontSize="12" Foreground="#2C3E50"
                                                   ToolTip="{Binding RightFull}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty-state overlay -->
                    <Border Grid.Row="3" IsHitTestVisible="False" Margin="20"
                            Background="#F7FBFF" BorderBrush="#D3E2F0" BorderThickness="1" CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=lvResults, Path=HasItems}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                            <TextBlock Text="No comparison results yet"
                                       FontSize="18" FontWeight="SemiBold"
                                       Foreground="#31516F" HorizontalAlignment="Center"/>
                            <TextBlock Text="Select left and right folders, then click ▶ Start."
                                       Margin="0,6,0,0" FontSize="12"
                                       Foreground="#5E6B78" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Splitter -->
                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                              VerticalAlignment="Center" Background="#C9D9EA" ShowsPreview="True"/>

                <!-- Log panel -->
                <TextBox Grid.Row="2" x:Name="txtLog"
                         Text="{Binding LogText, Mode=OneWay}"
                         VerticalAlignment="Stretch"
                         VerticalScrollBarVisibility="Auto"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         Margin="0,6,0,0" FontSize="11" IsReadOnly="True"
                         Background="#FAFCFF" BorderBrush="#D3E2F0" BorderThickness="1"
                         Padding="8"/>
            </Grid>
        </DockPanel>
    </Border>
</mah:MetroWindow>
